---
interface Props {
  items: { question: string; answer: string }[];
}
const { items } = Astro.props;
---

<div data-accordion class="space-y-3">
  {
    items.map((item, i) => (
      <div
        data-accordion-item
        data-open={i === 0 ? "true" : "false"}
        class="glass overflow-hidden transition-colors duration-200 hover:border-brand/30"
      >
        <button
          data-accordion-trigger
          type="button"
          aria-expanded={i === 0 ? "true" : "false"}
          class="group flex w-full cursor-pointer items-center gap-4 px-6 py-5 text-left font-display text-base font-semibold text-white"
        >
          <span class="flex-1">{item.question}</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="chevron h-5 w-5 shrink-0 text-brand-soft transition-transform duration-300"
          >
            <path d="m6 9 6 6 6-6" />
          </svg>
        </button>
        <div
          data-accordion-panel
          class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out"
        >
          <div class="overflow-hidden">
            <div
              class="px-6 pb-6 text-sm text-fg-muted leading-relaxed"
              set:html={item.answer}
            />
          </div>
        </div>
      </div>
    ))
  }
</div>

<style>
  [data-accordion-item][data-open="true"] [data-accordion-panel] {
    grid-template-rows: 1fr;
  }
  [data-accordion-item][data-open="true"] [data-accordion-trigger] .chevron {
    transform: rotate(180deg);
  }
  [data-accordion-item][data-open="true"] {
    border-color: rgba(23, 178, 255, 0.35);
    box-shadow: 0 0 30px -10px rgba(23, 178, 255, 0.4);
  }
</style>
