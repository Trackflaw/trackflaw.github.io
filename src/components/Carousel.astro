---
export interface CarouselSlide {
  image: string;
  alt?: string;
  eyebrow?: string;
  title: string;
  description: string;
}

interface Props {
  id: string;
  slides: CarouselSlide[];
  autoplay?: number;
  ariaLabel?: string;
}

const {
  id,
  slides,
  autoplay = 6000,
  ariaLabel = "Carrousel de fonctionnalités",
} = Astro.props;
---

<section
  data-carousel
  data-autoplay={autoplay}
  id={id}
  aria-roledescription="carousel"
  aria-label={ariaLabel}
  class="carousel-root relative overflow-hidden rounded-2xl border border-white/10 bg-bg-2/40 shadow-[0_0_60px_-15px_rgba(23,178,255,0.4)] backdrop-blur-md"
>
  <div class="carousel-viewport overflow-hidden">
    <ol data-carousel-track class="carousel-track flex">
      {
        slides.map((slide, i) => (
          <li
            class="carousel-slide relative w-full flex-shrink-0 overflow-hidden bg-bg"
            aria-roledescription="slide"
            aria-label={`${i + 1} sur ${slides.length}`}
          >
            <img
              src={slide.image}
              alt=""
              aria-hidden="true"
              draggable="false"
              loading={i === 0 ? "eager" : "lazy"}
              decoding="async"
              class="pointer-events-none absolute inset-0 h-full w-full scale-110 select-none object-cover opacity-35 blur-2xl"
            />
            <img
              src={slide.image}
              alt={slide.alt ?? slide.title}
              draggable="false"
              loading={i === 0 ? "eager" : "lazy"}
              decoding="async"
              class="relative aspect-[2/1] w-full select-none object-contain"
            />
            <div class="pointer-events-none absolute inset-x-0 bottom-0 flex flex-col gap-2 bg-gradient-to-t from-bg-2/98 via-bg-2/80 to-transparent px-6 pb-16 pt-14 sm:px-10">
              {slide.eyebrow && (
                <span class="inline-flex w-fit items-center gap-2 rounded-full border border-brand-neon/30 bg-brand/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-brand-soft backdrop-blur-md">
                  {slide.eyebrow}
                </span>
              )}
              <h4 class="font-display text-xl font-semibold text-white sm:text-2xl">
                <span class="text-gradient">{slide.title}</span>
              </h4>
              <p class="max-w-2xl text-sm leading-relaxed text-fg-muted">
                {slide.description}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>

  <button
    data-carousel-prev
    type="button"
    aria-label="Diapositive précédente"
    class="carousel-arrow absolute left-3 top-1/2 z-10 inline-flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-white/15 bg-bg-2/60 text-white backdrop-blur-md transition-all duration-300 hover:border-brand-neon/60 hover:bg-bg-2/80 hover:shadow-[0_0_24px_-6px_rgba(92,225,255,0.6)] sm:h-11 sm:w-11"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      class="h-5 w-5"
    >
      <path d="m15 18-6-6 6-6"></path>
    </svg>
  </button>

  <button
    data-carousel-next
    type="button"
    aria-label="Diapositive suivante"
    class="carousel-arrow absolute right-3 top-1/2 z-10 inline-flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-white/15 bg-bg-2/60 text-white backdrop-blur-md transition-all duration-300 hover:border-brand-neon/60 hover:bg-bg-2/80 hover:shadow-[0_0_24px_-6px_rgba(92,225,255,0.6)] sm:h-11 sm:w-11"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      class="h-5 w-5"
    >
      <path d="m9 18 6-6-6-6"></path>
    </svg>
  </button>

  <nav
    aria-label="Choisir une diapositive"
    class="absolute inset-x-0 bottom-4 z-10 flex justify-center gap-2"
  >
    {
      slides.map((_, i) => (
        <button
          data-carousel-dot={i}
          type="button"
          aria-label={`Aller à la diapositive ${i + 1}`}
          aria-current={i === 0 ? "true" : "false"}
          class="carousel-dot h-2 w-2 rounded-full border border-white/40 bg-white/15 transition-all duration-300"
        />
      ))
    }
  </nav>
</section>

<style>
  .carousel-track {
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
    touch-action: pan-y;
  }
  .carousel-track.is-dragging {
    transition: none;
    cursor: grabbing;
  }
  .carousel-slide img {
    -webkit-user-drag: none;
    user-select: none;
  }
  .carousel-dot[aria-current="true"] {
    width: 1.4rem;
    background: linear-gradient(
      90deg,
      rgba(92, 225, 255, 0.95),
      rgba(23, 178, 255, 0.95)
    );
    border-color: transparent;
    box-shadow: 0 0 12px rgba(92, 225, 255, 0.7);
  }
</style>
