<footer class="relative mt-32 border-t border-white/5 pt-16 pb-10">
  <div
    class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-brand/40 to-transparent"
  >
  </div>

  <div class="mx-auto grid max-w-6xl gap-10 px-5 sm:px-8 md:grid-cols-3 md:items-center">
    <div class="flex flex-col items-center gap-3 md:items-start">
      <a href="/" class="flex items-center gap-3 no-underline">
        <img
          src="/logos/Original-transparent-bleu.png"
          alt="Logo Trackflaw"
          width="40"
          height="40"
          class="h-10 w-10 object-contain"
        />
        <span class="font-display text-base font-light uppercase tracking-[0.12em] text-white/55">
          TRACKFLAW
        </span>
      </a>
      <p class="text-sm text-fg-dim">
        Votre cybersécurité, simplement.
      </p>
    </div>

    <div class="flex flex-col items-center gap-2 text-center">
      <p class="font-display text-sm text-fg-muted">
        © {new Date().getFullYear()} Trackflaw,
        <a href="/mentions-légales" class="hover:text-brand-soft">Mentions légales</a>
      </p>
      <p class="text-xs text-fg-dim">
        SAS · SIRET 928 024 389 00019
      </p>
    </div>

    <ul class="flex flex-wrap items-center justify-center gap-2 md:justify-end">
      {
        socials.map((s) => (
          <li>
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.label}
              title={s.label}
              class="group inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/10 bg-white/5 text-fg-muted backdrop-blur-md transition-all duration-300 hover:border-brand/50 hover:bg-white/10 hover:text-brand-soft hover:shadow-[0_0_25px_-8px_rgba(23,178,255,0.6)]"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="h-4 w-4"
                aria-hidden="true"
              >
                <path d={s.path} />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
