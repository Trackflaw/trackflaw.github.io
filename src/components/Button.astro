---
interface Props {
  href?: string;
  variant?: "primary" | "ghost" | "outline";
  size?: "sm" | "md" | "lg";
  class?: string;
  target?: string;
  rel?: string;
  type?: "button" | "submit" | "reset";
  id?: string;
}
const {
  href,
  variant = "primary",
  size = "md",
  class: className = "",
  target,
  rel,
  type,
  id,
} = Astro.props;

const sizes = {
  sm: "px-4 py-2 text-sm",
  md: "px-6 py-3 text-base",
  lg: "px-8 py-4 text-base",
};

const variants = {
  primary:
    "btn-electric bg-gradient-to-br from-brand-neon/90 via-brand to-brand-deep text-white shadow-[0_0_18px_rgba(23,178,255,0.4),0_0_45px_rgba(23,178,255,0.25)] hover:shadow-[0_0_28px_rgba(92,225,255,0.55),0_0_70px_rgba(23,178,255,0.4)]",
  ghost:
    "bg-white/5 text-white border border-white/15 backdrop-blur-md hover:bg-white/[0.09] hover:border-brand-neon/50 hover:shadow-[0_0_1px_rgba(92,225,255,0.7),0_0_24px_rgba(23,178,255,0.45)]",
  outline:
    "bg-transparent text-white border border-white/25 hover:border-brand-neon hover:bg-brand/10 hover:shadow-[0_0_1px_rgba(92,225,255,0.7),0_0_24px_rgba(23,178,255,0.45)]",
};

const base =
  "inline-flex items-center justify-center gap-2 rounded-full font-display font-semibold tracking-wide transition-all duration-300 ease-out cursor-pointer no-underline";
const cls = `${base} ${sizes[size]} ${variants[variant]} ${className}`;

const externalAttrs =
  href && /^https?:\/\//.test(href) && !rel
    ? { rel: "noopener noreferrer" }
    : { rel };
---

{
  href ? (
    <a
      id={id}
      href={href}
      target={target}
      rel={externalAttrs.rel}
      class={cls}
    >
      <slot />
    </a>
  ) : (
    <button id={id} type={type ?? "button"} class={cls}>
      <slot />
    </button>
  )
}
