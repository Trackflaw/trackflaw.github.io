---
import { socialUrls } from "../data/social";
import {
  latestLinkedInPost,
  buildLinkedInEmbedUrl,
  estimateEmbedHeight,
  formatLinkedInDate,
} from "../utils/linkedin";

// Read from the repo, not from the network: see `src/utils/linkedin.ts`.
const post = latestLinkedInPost();
const embedUrl = post ? buildLinkedInEmbedUrl(post.id) : null;

// A cross-origin iframe cannot size itself, so the height is decided here,
// once per breakpoint, from the width the iframe actually gets. Those widths
// come from `Container` (`px-5 sm:px-8`) and the `max-w-3xl` wrapper in
// `index.astro`: about 340px on a phone, and between 704 and 768px above the
// `md` breakpoint. Each step uses the narrowest width of its range, since a
// narrower iframe wraps the text into more lines and needs more height.
const heights = post
  ? {
      sm: estimateEmbedHeight(post, 340),
      md: estimateEmbedHeight(post, 704),
    }
  : { sm: 0, md: 0 };
---

<div
  class="reveal glass relative overflow-hidden p-0"
  style={`--embed-h-sm: ${heights.sm}px; --embed-h-md: ${heights.md}px;`}
>
  <header
    class="flex items-center justify-between gap-3 border-b border-white/5 px-6 py-4"
  >
    <div class="flex items-center gap-3">
      <span
        class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-[#0a66c2] shadow-[0_0_24px_-8px_rgba(10,102,194,0.7)]"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="white"
          aria-hidden="true"
          class="h-5 w-5"
        >
          <path
            d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zM8.339 18.337v-8.27H5.667v8.27zM7.003 8.91a1.55 1.55 0 1 0 0-3.1 1.55 1.55 0 0 0 0 3.1zm11.335 9.427v-4.529c0-2.42-.524-4.286-3.351-4.286-1.36 0-2.273.747-2.647 1.456h-.039v-1.232H9.738v8.591h2.681v-4.252c0-1.121.214-2.207 1.604-2.207 1.371 0 1.39 1.282 1.39 2.279v4.18z"
          />
        </svg>
      </span>
      <div>
        <p class="font-display text-sm font-semibold text-white">Trackflaw</p>
        <p class="text-xs text-fg-dim">
          {post ? formatLinkedInDate(post.publishedAt) : "Dernière publication"}
        </p>
      </div>
    </div>
    <a
      href={socialUrls.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-semibold text-white backdrop-blur-md transition-colors duration-300 hover:border-[#0a66c2]/60 hover:bg-[#0a66c2]/15"
    >
      Suivre
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-3.5 w-3.5"
      >
        <path d="M5 12h14"></path>
        <path d="m12 5 7 7-7 7"></path>
      </svg>
    </a>
  </header>

  {
    embedUrl ? (
      <iframe
        class="embed-frame w-full border-0 bg-white"
        title="Dernière publication de Trackflaw sur LinkedIn"
        src={embedUrl}
        loading="lazy"
        allowfullscreen
      />
    ) : (
      <div class="flex flex-col items-center justify-center gap-4 bg-bg-2 p-10 text-center">
        <p class="font-display text-base text-white">
          Suivez-nous pour ne rien manquer.
        </p>
        <p class="max-w-sm text-sm text-fg-muted">
          Veille, retours d'audit et publications techniques de l'équipe
          Trackflaw.
        </p>
        <a
          href={socialUrls.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full bg-[#0a66c2] px-5 py-2.5 text-sm font-semibold text-white shadow-[0_0_24px_-8px_rgba(10,102,194,0.7)] transition-all duration-300 hover:shadow-[0_0_36px_-6px_rgba(10,102,194,0.9)]"
        >
          Voir la page Trackflaw
        </a>
      </div>
    )
  }
</div>

<style>
  /* The height comes from the post data, so it cannot be a Tailwind class:
     the JIT compiler only picks up class names it can see in the source. */
  .embed-frame {
    display: block;
    height: var(--embed-h-sm);
  }

  @media (min-width: 768px) {
    .embed-frame {
      height: var(--embed-h-md);
    }
  }
</style>
