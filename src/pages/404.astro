---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
---

<Layout
  title="Trackflaw | Erreur 404"
  description="Cette page n'existe pas."
  noindex
>
  <section
    class="relative flex min-h-screen items-center justify-center overflow-hidden px-5 pt-32 pb-16"
  >
    <div
      class="pointer-events-none absolute inset-0 -z-10 opacity-60"
      aria-hidden="true"
    >
      <div
        class="absolute left-1/2 top-1/2 h-[600px] w-[600px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand/10 blur-[120px]"
      >
      </div>
    </div>

    <div class="reveal mx-auto max-w-2xl text-center">
      <p
        class="font-mono text-sm uppercase tracking-[0.4em] text-brand-soft/80"
      >
        sigsegv · segmentation fault
      </p>
      <h1
        class="mt-6 text-7xl font-display font-bold tracking-tight sm:text-8xl"
      >
        <span class="text-gradient">404</span>
      </h1>
      <p class="mt-6 text-xl font-display text-white">
        Cette page n'existe pas.
      </p>
      <p class="mt-3 text-fg-muted">
        Tout va bien, rien n'est cassé. Le pointeur a juste déréférencé du vide.
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
        <Button href="/" variant="primary">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-4 w-4"
          >
            <path d="m12 19-7-7 7-7"></path>
            <path d="M19 12H5"></path>
          </svg>
          Retour à l'accueil
        </Button>
        <Button href="/services" variant="ghost">Voir nos services</Button>
      </div>
    </div>
  </section>
</Layout>
