---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import GlassCard from "../components/GlassCard.astro";
import SectionTitle from "../components/SectionTitle.astro";
import Button from "../components/Button.astro";
import Accordion from "../components/Accordion.astro";
import TeamCard from "../components/TeamCard.astro";
import Meter from "../components/Meter.astro";
import LinkedInPost from "../components/LinkedInPost.astro";
import SocialHub from "../components/SocialHub.astro";
import Carousel, { type CarouselSlide } from "../components/Carousel.astro";

const flawfenceSlides: CarouselSlide[] = [
  {
    image: "/images/flawfence/flawfence-1.png",
    alt: "Dashboard Flawfence avec score cyber et indicateurs clés",
    eyebrow: "Fonctionnalité 01",
    title: "Dashboard & KPI cyber",
    description:
      "Score cyber consolidé, indicateurs critiques en temps réel et vue d'ensemble de votre posture de sécurité pour décider vite et bien.",
  },
  {
    image: "/images/flawfence/flawfence-2.png",
    alt: "Cartographie des assets externes exposés",
    eyebrow: "Fonctionnalité 02",
    title: "Cartographie des assets externes",
    description:
      "Découverte automatique de votre périmètre exposé sous-domaines, services, certificats, fuites pour ne rien laisser hors de votre radar.",
  },
  {
    image: "/images/flawfence/flawfence-3.png",
    alt: "Scan de vulnérabilités agentique alimenté par l'IA",
    eyebrow: "Fonctionnalité 03",
    title: "Scan de vulnérabilité agentique",
    description:
      "Des agents IA orchestrent les scans, priorisent les vulnérabilités et reproduisent le raisonnement d'un auditeur offensif sans relâche, sans bruit.",
  },
];
import { team } from "../data/team";
import { faq } from "../data/faq";
import { socialUrls, youtubeChannelId } from "../data/social";
import { fetchLatestYouTubeVideos } from "../utils/youtube";

const youtubeVideos = await fetchLatestYouTubeVideos(youtubeChannelId, 4);
const youtubeChannelUrl = socialUrls.youtube;
const youtubeSubscribeUrl = socialUrls.youtubeSubscribe;

const missions = [
  {
    title: "Test d'intrusion",
    body: "Évaluez la sécurité de vos actifs web, internes ou mobiles à travers des scénarios d'attaque réalistes menés par nos auditeurs experts.",
    tags: ["Web", "Interne", "Mobile", "API"],
    icon: `<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/>`,
  },
  {
    title: "Réponse à incident",
    body: "Intervention rapide en cas d'attaque ou de suspicion. Investigation, gestion de crise, remise en état nous sommes à vos côtés.",
    tags: ["Forensic", "Crise", "Investigation"],
    icon: `<path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" x2="12" y1="9" y2="13"/><line x1="12" x2="12.01" y1="17" y2="17"/>`,
  },
  {
    title: "Accompagnement",
    body: "Formations sur mesure, préparation aux certifications offensives (OSCP, eCPPT) et sensibilisation des équipes en milieu pro ou académique.",
    tags: ["Formation", "OSCP", "Sensibilisation"],
    icon: `<path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c0 1 4 3 6 3s6-2 6-3v-5"/>`,
  },
];

const popular = [
  { title: "Test d'intrusion externe (web)", subtitle: "Évaluation de la sécurité d'une application web", level: "very-high" as const, value: 90, label: "Très forte demande" },
  { title: "Test d'intrusion externe (système & réseau)", subtitle: "Évaluation de la sécurité système et réseau d'un hôte", level: "high" as const, value: 80, label: "Forte demande" },
  { title: "Test d'intrusion interne", subtitle: "Évaluation de la sécurité interne d'une entreprise", level: "high" as const, value: 70, label: "Demande importante" },
];

const popularMeterIcon = `<path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/>`;
---

<Layout
  title="Trackflaw | Expert en sécurité offensive"
  description="Trackflaw est une startup spécialisée dans la sécurité offensive et particulièrement dans le domaine des tests d'intrusion."
>
  <!-- HERO -->
  <section class="relative isolate flex min-h-[100svh] items-center justify-center overflow-hidden">
    <video
      class="absolute inset-0 -z-20 h-full w-full object-cover"
      autoplay
      loop
      muted
      playsinline
    >
      <source src="/assets/videos/background.mp4" type="video/mp4" />
    </video>
    <div
      class="pointer-events-none absolute inset-0 -z-10"
      aria-hidden="true"
      style="background: radial-gradient(ellipse 80% 80% at 50% 45%, transparent 0%, rgba(4,6,13,0.35) 60%, rgba(4,6,13,0.95) 100%);"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-32 bg-gradient-to-b from-transparent to-bg"
      aria-hidden="true"
    >
    </div>

    <div class="relative mx-auto max-w-5xl px-5 text-center">
      <p class="reveal inline-flex items-center gap-2 rounded-full border border-brand-neon/40 bg-white/5 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.22em] text-brand-soft shadow-[0_0_24px_-6px_rgba(92,225,255,0.5)] backdrop-blur-xl">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand-neon opacity-80"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-brand-neon shadow-[0_0_8px_rgba(92,225,255,0.9)]"></span>
        </span>
        Sécurité offensive · Tests d'intrusion
      </p>
      <h1 class="reveal reveal-delay-1 mt-8 heading-soft font-display text-5xl font-light uppercase leading-tight tracking-[0.28em] sm:text-7xl md:text-8xl">
        TRACKFLAW
      </h1>
      <p class="reveal reveal-delay-2 mt-6 font-display text-2xl text-white/90 sm:text-3xl">
        Votre cybersécurité, <span class="text-gradient-neon">simplement</span>.
      </p>
      <p class="reveal reveal-delay-3 mx-auto mt-5 max-w-2xl text-base text-fg-muted sm:text-lg">
        Détection proactive des vulnérabilités, audits techniques offensifs et
        réponse à incident. Anticipez les attaques avant qu'elles n'arrivent.
      </p>
      <div class="reveal reveal-delay-4 mt-10 flex flex-wrap items-center justify-center gap-3">
        <Button href="#expertise" variant="primary" size="lg">
          Découvrir notre expertise
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-4 w-4"
          >
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </Button>
        <Button href="/commande" variant="ghost" size="lg">
          Commander un audit
        </Button>
      </div>

    </div>
  </section>

  <!-- MISSIONS -->
  <Section id="expertise" size="lg">
    <SectionTitle
      eyebrow="Nos missions"
      title='Votre cyber en <span class="text-gradient">3 missions</span>'
      subtitle="Trois piliers complémentaires pour anticiper, contrer et apprendre des cyberattaques."
    />

    <div class="mt-20 grid gap-6 md:grid-cols-3">
      {
        missions.map((m, i) => (
          <article
            data-spotlight
            class={`mission-card spotlight-card group glass glass-hover reveal reveal-delay-${i + 1} overflow-hidden p-8`}
          >
            <span
              aria-hidden="true"
              class="pointer-events-none absolute -bottom-10 -right-4 z-0 select-none font-display text-[14rem] font-black leading-none text-white/[0.025]"
            >
              {String(i + 1).padStart(2, "0")}
            </span>

            <div class="relative z-10 flex h-full flex-col">
              <div class="mb-7 inline-flex h-16 w-16 items-center justify-center rounded-2xl border border-brand-neon/25 bg-gradient-to-br from-brand-neon/15 via-brand/10 to-transparent text-brand-soft shadow-[inset_0_1px_0_0_rgba(255,255,255,0.08),0_0_30px_-12px_rgba(92,225,255,0.6)]">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-7 w-7"
                  set:html={m.icon}
                />
              </div>

              <h3 class="font-display text-2xl font-semibold leading-tight text-white">
                <span class="text-gradient">{m.title}</span>
              </h3>

              <p class="mt-4 flex-1 text-sm leading-relaxed text-fg-muted">
                {m.body}
              </p>

              <div class="mt-6 flex flex-wrap gap-2">
                {m.tags.map((t) => (
                  <span class="inline-flex items-center rounded-full border border-white/10 bg-white/[0.04] px-2.5 py-1 text-[11px] font-medium text-fg-muted backdrop-blur-md transition-colors duration-500 group-hover:border-brand-neon/25 group-hover:text-brand-soft">
                    {t}
                  </span>
                ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </Section>

  <!-- FLAWFENCE -->
  <Section size="md" containerSize="lg">
    <div class="reveal text-center">
      <p class="inline-flex items-center gap-2 rounded-full border border-brand-neon/30 bg-brand/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.22em] text-brand-soft backdrop-blur-md">
        Nouveau · Produit SaaS
      </p>
      <h2 class="mt-4 font-display text-3xl font-bold text-white sm:text-4xl">
        Avez-vous testé notre nouvel outil
        <span class="text-gradient">Flawfence</span> ?
      </h2>
      <p class="mx-auto mt-5 max-w-2xl text-fg-muted leading-relaxed">
        Solution SaaS basée sur l'IA pour contrôler et perfectionner
        l'exposition externe de votre entreprise. Automatisation efficace de
        vos audits offensifs.
      </p>
    </div>

    <div class="reveal mt-12">
      <Carousel
        id="flawfence-carousel"
        ariaLabel="Fonctionnalités de Flawfence"
        slides={flawfenceSlides}
        autoplay={6500}
      />
    </div>

    <div class="reveal mt-10 flex justify-center">
      <Button href="https://flawfence.com" variant="primary" target="_blank">
        Découvrir flawfence.com
      </Button>
    </div>
  </Section>

  <!-- ABOUT -->
  <Section id="about" size="lg" containerSize="lg">
    <div class="grid items-center gap-10 lg:grid-cols-2">
      <div class="reveal relative">
        <div class="glass relative aspect-square overflow-hidden p-0">
          <div
            class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_70%_60%_at_50%_50%,rgba(92,225,255,0.18),transparent_70%)]"
            aria-hidden="true"
          >
          </div>
          <img
            src="/logos/Original-transparent-bleu.png"
            alt="Logo Trackflaw"
            loading="lazy"
            class="relative z-10 h-full w-full object-contain p-16 drop-shadow-[0_0_40px_rgba(92,225,255,0.4)]"
          />
        </div>
        <div
          class="pointer-events-none absolute -inset-6 -z-10 rounded-[2rem] bg-brand/15 blur-3xl"
          aria-hidden="true"
        >
        </div>
      </div>
      <div class="reveal reveal-delay-1">
        <p class="inline-flex items-center gap-2 rounded-full border border-brand/30 bg-brand/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-brand-soft">
          À propos
        </p>
        <h2 class="mt-4 font-display text-4xl font-bold sm:text-5xl">
          À propos de <span class="text-gradient">nous</span>
        </h2>
        <p class="mt-6 text-fg-muted leading-relaxed">
          <strong class="text-white">Trackflaw</strong> est une startup
          spécialisée dans les tests d'intrusion et la réponse à incident.
          Son domaine d'expertise varie des tests d'intrusion externes,
          internes et mobiles aux formations spécialisées en sécurité
          informatique en passant par des missions de gestion de crise.
        </p>
        <p class="mt-6 text-fg-muted leading-relaxed">
          En se
          concentrant uniquement sur les tests d'intrusion, Trackflaw a pour
          vocation de fournir des
          <a href="/méthodologie">prestations de haute technicité</a> afin de
          garantir l'exhaustivité et la qualité des tests effectués.
        </p>
      </div>
    </div>
  </Section>

  <!-- ATTAQUE = MEILLEURE DEFENSE -->
  <Section size="md" containerSize="lg">
    <GlassCard strong hover class="reveal grid items-center gap-8 lg:grid-cols-[2fr_1fr]">
      <div>
        <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl border border-brand/30 bg-brand/10 text-brand-soft">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
            <path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1zM15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c.75 0 1.25 0 1.25 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/>
          </svg>
        </div>
        <h2 class="font-display text-3xl font-bold sm:text-4xl">
          L'attaque est la meilleure <span class="text-gradient">défense</span>
        </h2>
        <p class="mt-4 text-fg-muted leading-relaxed">
          L'approche offensive des audits techniques permet de déceler les
          faiblesses pouvant être exploitées par un acteur malveillant. En
          connaissant vos failles, vous renforcez vos défenses.
        </p>
      </div>
      <div class="flex justify-start lg:justify-end">
        <Button href="/services" variant="primary">Consulter nos offres</Button>
      </div>
    </GlassCard>
  </Section>

  <!-- FAQ -->
  <Section size="lg" containerSize="md">
    <SectionTitle
      eyebrow="Foire aux questions"
      title='Les <span class="text-gradient">problématiques</span> de nos clients'
      align="left"
    />
    <div class="reveal mt-10">
      <Accordion items={faq} />
    </div>
  </Section>

  <!-- TEAM -->
<!--  <Section id="team" size="lg" containerSize="xl">
    <SectionTitle
      eyebrow="L'équipe"
      title='Notre <span class="text-gradient">équipe</span>'
      subtitle="Trackflaw a été fondé en 2022 par <strong>Thibaud ROBIN</strong>, directeur général, à la suite de nombreuses expériences en tant que consultant pour des clients grands comptes."
    />
    <div class="mx-auto mt-16 grid max-w-2xl grid-cols-1 gap-6 sm:grid-cols-2">
      {team.map((m, i) => <TeamCard member={m} delay={(i % 4) as 0 | 1 | 2 | 3} />)}
    </div>
  </Section>-->

  <!-- POURQUOI + REFERENCEMENT -->
  <Section size="lg" containerSize="lg">
    <div class="grid gap-6 lg:grid-cols-2">
      <GlassCard hover class="reveal flex flex-col">
        <h3 class="font-display text-2xl font-bold text-white">
          🤔 Pourquoi choisir <span class="text-gradient">Trackflaw</span> ?
        </h3>
        <p class="mt-4 flex-1 text-fg-muted leading-relaxed">
          Le marché de la sécurité offensive et plus précisément celui du test
          d'intrusion est un domaine très compétitif. Trackflaw se positionne
          en s'appuyant sur une organisation et une méthodologie pointue et
          exigeante afin de garantir un haut niveau de qualité.
        </p>
        <div class="mt-6">
          <Button href="/valeurs" variant="ghost" size="sm">
            Les 5 raisons de choisir Trackflaw
          </Button>
        </div>
      </GlassCard>

      <GlassCard hover class="reveal reveal-delay-1 relative min-h-[240px] pb-32 pr-6 sm:pb-6 sm:pr-44">
        <h3 class="font-display text-2xl font-bold text-white">
          🎓 Entreprise référencée
        </h3>
        <p class="mt-3 text-sm text-fg-muted leading-relaxed">
          Trackflaw est référencée sur l'organisation gouvernementale
          <a
            href="https://www.cybermalveillance.gouv.fr/"
            target="_blank"
            rel="noopener noreferrer">cybermalveillance.gouv.fr</a> comme
          prestataire de confiance.
        </p>
        <a
          href="https://www.cybermalveillance.gouv.fr/"
          target="_blank"
          rel="noopener noreferrer"
          class="absolute bottom-5 right-5 block w-32 rounded-xl border border-white/10 bg-white p-2.5 transition hover:border-brand/40 hover:shadow-[0_0_24px_-8px_rgba(23,178,255,0.5)] sm:w-36"
        >
          <img
            src="/images/logo-pro.png"
            alt="Cybermalveillance"
            loading="lazy"
            class="w-full"
          />
        </a>
      </GlassCard>
    </div>
  </Section>

  <!-- LINKEDIN -->
  <Section size="lg" containerSize="md">
    <SectionTitle
      eyebrow="Page LinkedIn"
      title='Notre dernière <span class="text-gradient">publication</span>'
      subtitle="Veille, retours d'audit et publications techniques de l'équipe."
    />
    <div class="mt-12 mx-auto max-w-3xl">
      <LinkedInPost />
    </div>
  </Section>

  <!-- BLOG -->
  <Section size="lg" containerSize="lg">
    <SectionTitle
      eyebrow="Blog technique"
      title='Notre dernier <span class="text-gradient">article</span>'
    />
    <div class="reveal mt-12 aspect-video w-full overflow-hidden rounded-2xl border border-white/10 shadow-[0_0_60px_-15px_rgba(23,178,255,0.4)]">
      <iframe
        title="Blog Trackflaw"
        src="https://blog.trackflaw.com/histoire-myst%C3%A8rieuse-inqui%C3%A9tante-puce-intel/"
        loading="lazy"
        class="h-full w-full"
      ></iframe>
    </div>
  </Section>

  <!-- YOUTUBE MOSAIC -->
  <Section size="lg" containerSize="lg">
    <SectionTitle
      eyebrow="YouTube · @trackflaw"
      title='La cybersécurité <span class="text-gradient">accessible</span> pour tous'
      subtitle="Décryptages, démos et bonnes pratiques. Abonnez-vous pour ne rien manquer de nos prochaines vidéos."
    />

    <div class="reveal mt-10 flex flex-col items-center justify-between gap-4 rounded-2xl border border-white/10 bg-white/[0.025] px-5 py-4 backdrop-blur-md sm:flex-row sm:gap-6">
      <div class="flex items-center gap-3">
        <span class="relative inline-flex h-11 w-16 items-center justify-center rounded-xl bg-gradient-to-br from-[#ff3340] to-[#cc0000] shadow-[0_0_24px_-6px_rgba(255,51,64,0.6)]">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="white"
            aria-hidden="true"
            class="h-5 w-5"
          >
            <path d="M8 5v14l11-7z" />
          </svg>
        </span>
        <div>
          <p class="font-display text-base font-semibold text-white">
            @trackflaw
          </p>
          <p class="text-xs text-fg-muted">Notre chaîne YouTube officielle</p>
        </div>
      </div>
      <a
        href={youtubeSubscribeUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full bg-gradient-to-br from-[#ff3340] to-[#b91c1c] px-5 py-2.5 text-sm font-semibold text-white shadow-[0_0_24px_-8px_rgba(255,51,64,0.6)] transition-all duration-300 hover:shadow-[0_0_36px_-6px_rgba(255,51,64,0.8)]"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
          class="h-4 w-4"
        >
          <path d="M21.58 7.19a2.51 2.51 0 0 0-1.77-1.77C18.25 5 12 5 12 5s-6.25 0-7.81.42a2.51 2.51 0 0 0-1.77 1.77A26 26 0 0 0 2 12a26 26 0 0 0 .42 4.81 2.51 2.51 0 0 0 1.77 1.77C5.75 19 12 19 12 19s6.25 0 7.81-.42a2.51 2.51 0 0 0 1.77-1.77A26 26 0 0 0 22 12a26 26 0 0 0-.42-4.81zM10 15V9l5.2 3z" />
        </svg>
        S'abonner
      </a>
    </div>

    {
      youtubeVideos.length > 0 ? (
        <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {youtubeVideos.map((v, i) => (
            <a
              href={v.url}
              target="_blank"
              rel="noopener noreferrer"
              class={`reveal reveal-delay-${(i % 4) + 1} group glass glass-hover relative block overflow-hidden p-0 no-underline`}
              aria-label={`Regarder ${v.title} sur YouTube`}
            >
              <div class="relative aspect-video overflow-hidden">
                <img
                  src={v.thumbnail}
                  alt=""
                  loading="lazy"
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                />
                <div
                  aria-hidden="true"
                  class="absolute inset-0 bg-gradient-to-t from-bg-2/95 via-bg-2/30 to-transparent"
                />
                <span
                  aria-hidden="true"
                  class="absolute inset-0 flex items-center justify-center"
                >
                  <span class="inline-flex h-14 w-14 items-center justify-center rounded-full border border-white/20 bg-black/40 backdrop-blur-md transition-all duration-500 group-hover:scale-110 group-hover:border-brand-neon/60 group-hover:bg-black/55 group-hover:shadow-[0_0_30px_-4px_rgba(92,225,255,0.6)]">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="white"
                      class="ml-1 h-5 w-5"
                    >
                      <path d="M8 5v14l11-7z" />
                    </svg>
                  </span>
                </span>
              </div>
              <div class="px-5 py-4">
                <p class="line-clamp-2 font-display text-sm font-semibold leading-snug text-white transition-colors duration-300 group-hover:text-brand-soft">
                  {v.title}
                </p>
                <p class="mt-1 text-xs text-fg-dim">
                  {new Date(v.publishedAt).toLocaleDateString("fr-FR", {
                    day: "numeric",
                    month: "long",
                    year: "numeric",
                  })}
                </p>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="reveal mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {Array.from({ length: 4 }).map(() => (
            <a
              href={youtubeChannelUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="group glass glass-hover relative block overflow-hidden p-0 no-underline"
            >
              <div class="relative flex aspect-video items-center justify-center overflow-hidden bg-gradient-to-br from-brand/10 via-bg-2 to-bg-2">
                <span class="inline-flex h-14 w-14 items-center justify-center rounded-full border border-white/20 bg-black/40 backdrop-blur-md transition group-hover:scale-110 group-hover:border-brand-neon/60">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="white"
                    class="ml-1 h-5 w-5"
                  >
                    <path d="M8 5v14l11-7z" />
                  </svg>
                </span>
              </div>
              <div class="px-5 py-4">
                <p class="font-display text-sm font-semibold text-white">
                  Voir notre dernière vidéo
                </p>
                <p class="mt-1 text-xs text-fg-dim">youtube.com/@trackflaw</p>
              </div>
            </a>
          ))}
        </div>
      )
    }

    <div class="reveal mt-10 flex justify-center">
      <a
        href={youtubeChannelUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-sm font-medium text-fg-muted transition-colors duration-300 hover:text-brand-soft"
      >
        Voir toutes les vidéos
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-4 w-4"
        >
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </Section>

  <!-- SOCIAL HUB -->
  <Section size="lg" containerSize="lg">
    <SectionTitle
      eyebrow="Réseaux sociaux"
      title='Suivez-nous au <span class="text-gradient">quotidien</span>'
      subtitle="Trois plateformes, un même handle <strong>@trackflaw</strong>. Choisissez votre format préféré."
    />
    <div class="mt-12">
      <SocialHub />
    </div>
  </Section>

  <!-- POPULAIRES + CONTACT -->
  <Section size="lg" containerSize="md">
    <SectionTitle
      eyebrow="Top demandes"
      title='Nos 3 services les plus <span class="text-gradient">populaires</span>'
    />

    <GlassCard hover class="reveal mt-12 space-y-7">
      {
        popular.map((p) => (
          <div>
            <h4 class="font-display text-base font-bold text-white">
              {p.title}
            </h4>
            <p class="text-xs italic text-fg-muted">{p.subtitle}</p>
            <div class="mt-3">
              <Meter
                label={p.label}
                level={p.level}
                value={p.value}
                icon={popularMeterIcon}
              />
            </div>
          </div>
        ))
      }
      <div class="flex justify-center pt-4">
        <Button href="/méthodologie" variant="primary">
          En savoir plus sur nos missions
        </Button>
      </div>
    </GlassCard>

    <div class="reveal mt-20 text-center">
      <h2 class="font-display text-3xl font-bold sm:text-4xl">
        Une <span class="text-gradient">question</span> ?
      </h2>
      <p class="mt-4 text-fg-muted">Écrivez-nous, nous vous répondons rapidement.</p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <Button href="mailto:contact@trackflaw.com" variant="primary">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
            <rect width="20" height="16" x="2" y="4" rx="2"/>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
          </svg>
          contact@trackflaw.com
        </Button>
        <Button href="/commande" variant="ghost">Commander un audit</Button>
      </div>
    </div>
  </Section>
</Layout>
